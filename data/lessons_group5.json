            }
          ],
          "base_form": "לֹא",
          "suffix_form": "",
          "suffix_kind": null,
          "suffix_pgn": null,
          "lemma_citation_form": "לֹא",
          "lemma_transliteration": "lo'",
          "gloss": "not",
          "highlight": "base",
          "note": "Another vav doing more than “and”: “...so that we don't perish”, expressing a hoped-for result rather than simply adding a fact. Same prefix, a purpose/result sense instead of a contrast."
        }
